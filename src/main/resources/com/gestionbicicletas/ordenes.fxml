<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gestionbicicletas.controller.OrdenServicioController"
            stylesheets="@styles.css">

    <!-- ========================= -->
    <!-- ENCABEZADO -->
    <!-- ========================= -->

    <top>

        <HBox spacing="15"
              alignment="CENTER_LEFT">

            <padding>
                <Insets top="20"
                        right="25"
                        bottom="20"
                        left="25"/>
            </padding>

            <Button text="← Volver"
                    onAction="#volverAlMenu"
                    styleClass="boton-secundario"/>

            <Label text="Órdenes de Servicio"
                   styleClass="titulo-principal"/>

        </HBox>

    </top>


    <!-- ========================= -->
    <!-- CONTENIDO PRINCIPAL -->
    <!-- ========================= -->

    <center>

        <HBox spacing="25">

            <!-- ========================= -->
            <!-- FORMULARIO -->
            <!-- ========================= -->

            <VBox prefWidth="450"
                  spacing="8"
                  styleClass="panel">

                <Label text="Nueva orden de servicio"
                       styleClass="titulo-seccion"/>


                <!-- ========================= -->
                <!-- DATOS PRINCIPALES -->
                <!-- ========================= -->

                <GridPane hgap="10"
                          vgap="8">

                    <Label text="Fecha:"
                           GridPane.rowIndex="0"
                           GridPane.columnIndex="0"/>

                    <DatePicker fx:id="fechaIngreso"
                                prefWidth="220"
                                GridPane.rowIndex="0"
                                GridPane.columnIndex="1"/>


                    <Label text="Hora:"
                           GridPane.rowIndex="1"
                           GridPane.columnIndex="0"/>

                    <TextField fx:id="txtHora"
                               promptText="HH:mm"
                               prefWidth="220"
                               GridPane.rowIndex="1"
                               GridPane.columnIndex="1"/>


                    <Label text="Bicicleta:"
                           GridPane.rowIndex="2"
                           GridPane.columnIndex="0"/>

                    <ComboBox fx:id="comboBicicleta"
                              promptText="Selecciona una bicicleta"
                              prefWidth="220"
                              GridPane.rowIndex="2"
                              GridPane.columnIndex="1"/>


                    <Label text="Mecánico:"
                           GridPane.rowIndex="3"
                           GridPane.columnIndex="0"/>

                    <ComboBox fx:id="comboMecanico"
                              promptText="Selecciona un mecánico"
                              prefWidth="220"
                              GridPane.rowIndex="3"
                              GridPane.columnIndex="1"/>

                </GridPane>


                <!-- ========================= -->
                <!-- MOTIVO -->
                <!-- ========================= -->

                <Label text="Motivo del servicio:"
                       styleClass="etiqueta-formulario"/>

                <TextArea fx:id="txtMotivo"
                          promptText="Describe el motivo del servicio"
                          prefRowCount="1"
                          wrapText="true"/>


                <!-- ========================= -->
                <!-- DIAGNÓSTICO -->
                <!-- ========================= -->

                <Label text="Diagnóstico:"
                       styleClass="etiqueta-formulario"/>

                <TextArea fx:id="txtDiagnostico"
                          promptText="Describe el diagnóstico"
                          prefRowCount="1"
                          wrapText="true"/>


                <!-- ========================= -->
                <!-- TRABAJOS REALIZADOS -->
                <!-- ========================= -->

                <Label text="Trabajos realizados:"
                       styleClass="etiqueta-formulario"/>

                <TextArea fx:id="txtTrabajos"
                          promptText="Describe los trabajos realizados"
                          prefRowCount="1"
                          wrapText="true"/>


                <!-- ========================= -->
                <!-- COSTO -->
                <!-- ========================= -->

                <Label text="Costo total:"
                       styleClass="etiqueta-formulario"/>

                <TextField fx:id="txtCosto"
                           promptText="Ejemplo: 85000"/>


                <!-- ========================= -->
                <!-- REPUESTOS -->
                <!-- ========================= -->

                <Label text="Repuestos utilizados"
                       styleClass="titulo-seccion"/>


                <HBox spacing="8"
                      alignment="CENTER_LEFT">

                    <ComboBox fx:id="comboRepuesto"
                              promptText="Selecciona un repuesto"
                              HBox.hgrow="ALWAYS"/>

                    <TextField fx:id="txtCantidadRepuesto"
                               promptText="Cantidad"
                               prefWidth="80"/>

                    <Button text="Agregar"
                            onAction="#agregarRepuesto"
                            styleClass="boton-principal"
                            prefWidth="90"/>

                </HBox>


                <!-- ========================= -->
                <!-- TABLA DE REPUESTOS -->
                <!-- ========================= -->

                <TableView fx:id="tablaRepuestos"
                           prefHeight="75">

                    <columns>

                        <TableColumn fx:id="columnaRepuesto"
                                     text="Repuesto"
                                     prefWidth="190"/>

                        <TableColumn fx:id="columnaCantidad"
                                     text="Cantidad"
                                     prefWidth="80"/>

                    </columns>

                </TableView>


                <!-- ========================= -->
                <!-- ELIMINAR REPUESTO -->
                <!-- ========================= -->

                <Button text="Eliminar repuesto seleccionado"
                        onAction="#eliminarRepuesto"
                        styleClass="boton-secundario"
                        prefWidth="230"/>


                <!-- ========================= -->
                <!-- BOTONES PRINCIPALES -->
                <!-- ========================= -->

                <HBox spacing="10"
                      alignment="CENTER_LEFT">

                    <Button text="Registrar orden"
                            onAction="#registrarOrden"
                            styleClass="boton-principal"
                            prefWidth="180"/>

                    <Button text="Limpiar"
                            onAction="#limpiarCampos"
                            styleClass="boton-secundario"
                            prefWidth="100"/>

                </HBox>

            </VBox>


            <!-- ========================= -->
            <!-- TABLA DE ÓRDENES -->
            <!-- ========================= -->

            <VBox spacing="15"
                  VBox.vgrow="ALWAYS"
                  HBox.hgrow="ALWAYS"
                  styleClass="panel">

                <Label text="Órdenes registradas"
                       styleClass="titulo-seccion"/>


                <TableView fx:id="tablaOrdenes"
                           VBox.vgrow="ALWAYS">

                    <columns>

                        <!-- FECHA -->

                        <TableColumn fx:id="columnaFecha"
                                     text="Fecha"
                                     prefWidth="90"/>


                        <!-- HORA -->

                        <TableColumn fx:id="columnaHora"
                                     text="Hora"
                                     prefWidth="70"/>


                        <!-- BICICLETA -->

                        <TableColumn fx:id="columnaBicicleta"
                                     text="Serial bicicleta"
                                     prefWidth="130"/>


                        <!-- MECÁNICO -->

                        <TableColumn fx:id="columnaMecanico"
                                     text="Mecánico"
                                     prefWidth="150"/>


                        <!-- MOTIVO -->

                        <TableColumn fx:id="columnaMotivo"
                                     text="Motivo"
                                     prefWidth="200"/>


                        <!-- REPUESTOS -->

                        <TableColumn fx:id="columnaRepuestos"
                                     text="Repuestos utilizados"
                                     prefWidth="250"/>


                        <!-- COSTO -->

                        <TableColumn fx:id="columnaCosto"
                                     text="Costo"
                                     prefWidth="100"/>

                    </columns>

                </TableView>

            </VBox>

        </HBox>

    </center>


    <!-- ========================= -->
    <!-- ESPACIADO EXTERIOR -->
    <!-- ========================= -->

    <padding>

        <Insets top="10"
                right="25"
                bottom="25"
                left="25"/>

    </padding>

</BorderPane>