<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gestionbicicletas.controller.MecanicoController"
            stylesheets="@styles.css">

    <top>

        <HBox spacing="15"
              alignment="CENTER_LEFT">

            <padding>
                <Insets top="20"
                        right="25"
                        bottom="20"
                        left="25"/>
            </padding>

            <Button text="← Volver"
                    onAction="#volverAlMenu"
                    styleClass="boton-secundario"/>

            <Label text="Gestión de Mecánicos"
                   styleClass="titulo-principal"/>

        </HBox>

    </top>

    <center>

        <HBox spacing="30">

            <!-- FORMULARIO -->

            <VBox prefWidth="350"
                  spacing="15"
                  styleClass="panel">

                <Label text="Registrar mecánico"
                       styleClass="titulo-seccion"/>

                <GridPane hgap="10"
                          vgap="12">

                    <Label text="Nombre completo:"
                           GridPane.rowIndex="0"
                           GridPane.columnIndex="0"/>

                    <TextField fx:id="txtNombre"
                               promptText="Nombre completo"
                               GridPane.rowIndex="0"
                               GridPane.columnIndex="1"/>


                    <Label text="Especialidad:"
                           GridPane.rowIndex="1"
                           GridPane.columnIndex="0"/>

                    <ComboBox fx:id="comboEspecialidad"
                              promptText="Selecciona la especialidad"
                              prefWidth="210"
                              GridPane.rowIndex="1"
                              GridPane.columnIndex="1"/>


                    <Label text="Código:"
                           GridPane.rowIndex="2"
                           GridPane.columnIndex="0"/>

                    <TextField fx:id="txtCodigo"
                               promptText="Código de certificación"
                               GridPane.rowIndex="2"
                               GridPane.columnIndex="1"/>

                </GridPane>

                <HBox spacing="10">

                    <Button text="Registrar"
                            onAction="#registrarMecanico"
                            styleClass="boton-principal"/>

                    <Button text="Limpiar"
                            onAction="#limpiarCampos"
                            styleClass="boton-secundario"/>

                    <Button text="Eliminar seleccionado"
                            onAction="#eliminarMecanico"
                            styleClass="boton-eliminar"/>

                </HBox>

            </VBox>


            <!-- TABLA -->

            <VBox spacing="15"
                  VBox.vgrow="ALWAYS"
                  HBox.hgrow="ALWAYS"
                  styleClass="panel">

                <Label text="Mecánicos registrados"
                       styleClass="titulo-seccion"/>

                <TableView fx:id="tablaMecanicos"
                           VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn fx:id="columnaNombre"
                                     text="Nombre"
                                     prefWidth="200"/>

                        <TableColumn fx:id="columnaEspecialidad"
                                     text="Especialidad"
                                     prefWidth="220"/>

                        <TableColumn fx:id="columnaCodigo"
                                     text="Código"
                                     prefWidth="150"/>

                    </columns>

                </TableView>

            </VBox>

        </HBox>

    </center>

    <padding>
        <Insets top="10"
                right="25"
                bottom="25"
                left="25"/>
    </padding>

</BorderPane>