<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gestionbicicletas.controller.RepuestoController"
            stylesheets="@styles.css">

    <top>

        <HBox spacing="15"
              alignment="CENTER_LEFT">

            <padding>
                <Insets top="20"
                        right="25"
                        bottom="20"
                        left="25"/>
            </padding>

            <Button text="← Volver"
                    onAction="#volverAlMenu"
                    styleClass="boton-secundario"/>

            <Label text="Gestión de Repuestos"
                   styleClass="titulo-principal"/>

        </HBox>

    </top>

    <center>

        <HBox spacing="30">

            <!-- FORMULARIO -->

            <VBox prefWidth="350"
                  spacing="15"
                  styleClass="panel">

                <Label text="Registrar repuesto"
                       styleClass="titulo-seccion"/>

                <GridPane hgap="10"
                          vgap="12">

                    <Label text="Nombre:"
                           GridPane.rowIndex="0"
                           GridPane.columnIndex="0"/>

                    <TextField fx:id="txtNombre"
                               promptText="Nombre del repuesto"
                               GridPane.rowIndex="0"
                               GridPane.columnIndex="1"/>


                    <Label text="Cantidad:"
                           GridPane.rowIndex="1"
                           GridPane.columnIndex="0"/>

                    <TextField fx:id="txtCantidad"
                               promptText="Cantidad disponible"
                               GridPane.rowIndex="1"
                               GridPane.columnIndex="1"/>


                    <Label text="Stock mínimo:"
                           GridPane.rowIndex="2"
                           GridPane.columnIndex="0"/>

                    <TextField fx:id="txtStockMinimo"
                               promptText="Cantidad mínima"
                               GridPane.rowIndex="2"
                               GridPane.columnIndex="1"/>

                </GridPane>

                <HBox spacing="10">

                    <Button text="Registrar"
                            onAction="#registrarRepuesto"
                            styleClass="boton-principal"/>

                    <Button text="Limpiar"
                            onAction="#limpiarCampos"
                            styleClass="boton-secundario"/>

                </HBox>

                <Button text="Ver alertas de stock bajo"
                        onAction="#mostrarStockBajo"
                        styleClass="boton-eliminar"/>

            </VBox>


            <!-- TABLA -->

            <VBox spacing="15"
                  VBox.vgrow="ALWAYS"
                  HBox.hgrow="ALWAYS"
                  styleClass="panel">

                <Label text="Inventario de repuestos"
                       styleClass="titulo-seccion"/>

                <Label fx:id="lblAlertas"
                       text="No hay repuestos con stock bajo."
                       styleClass="instruccion"/>

                <TableView fx:id="tablaRepuestos"
                           VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn fx:id="columnaNombre"
                                     text="Repuesto"
                                     prefWidth="220"/>

                        <TableColumn fx:id="columnaCantidad"
                                     text="Cantidad"
                                     prefWidth="100"/>

                        <TableColumn fx:id="columnaStockMinimo"
                                     text="Stock mínimo"
                                     prefWidth="110"/>

                        <TableColumn fx:id="columnaEstado"
                                     text="Estado"
                                     prefWidth="130"/>

                    </columns>

                </TableView>

            </VBox>

        </HBox>

    </center>

    <padding>
        <Insets top="10"
                right="25"
                bottom="25"
                left="25"/>
    </padding>

</BorderPane>