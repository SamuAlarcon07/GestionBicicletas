<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gestionbicicletas.controller.ClienteController"
            stylesheets="@styles.css">

    <top>
        <HBox spacing="15" alignment="CENTER_LEFT">
            <padding>
                <Insets top="20" right="25" bottom="20" left="25"/>
            </padding>

            <Button text="← Volver"
                    onAction="#volverAlMenu"
                    styleClass="boton-secundario"/>

            <Label text="Gestión de Clientes"
                   styleClass="titulo-principal"/>
        </HBox>
    </top>

    <center>
        <HBox spacing="30">

            <VBox prefWidth="330"
                  spacing="15"
                  styleClass="panel">

                <Label text="Registrar cliente"
                       styleClass="titulo-seccion"/>

                <GridPane hgap="10"
                          vgap="12">

                    <Label text="Nombre completo:"
                           GridPane.rowIndex="0"
                           GridPane.columnIndex="0"/>

                    <TextField fx:id="txtNombre"
                               promptText="Nombre completo"
                               GridPane.rowIndex="0"
                               GridPane.columnIndex="1"/>

                    <Label text="Identificación:"
                           GridPane.rowIndex="1"
                           GridPane.columnIndex="0"/>

                    <TextField fx:id="txtIdentificacion"
                               promptText="Identificación"
                               GridPane.rowIndex="1"
                               GridPane.columnIndex="1"/>

                    <Label text="Teléfono:"
                           GridPane.rowIndex="2"
                           GridPane.columnIndex="0"/>

                    <TextField fx:id="txtTelefono"
                               promptText="Teléfono"
                               GridPane.rowIndex="2"
                               GridPane.columnIndex="1"/>

                    <Label text="Dirección:"
                           GridPane.rowIndex="3"
                           GridPane.columnIndex="0"/>

                    <TextField fx:id="txtDireccion"
                               promptText="Dirección"
                               GridPane.rowIndex="3"
                               GridPane.columnIndex="1"/>

                </GridPane>

                <HBox spacing="10">

                    <Button text="Registrar"
                            onAction="#registrarCliente"
                            styleClass="boton-principal"/>

                    <Button text="Limpiar"
                            onAction="#limpiarCampos"
                            styleClass="boton-secundario"/>

                </HBox>

            </VBox>

            <VBox spacing="15"
                  VBox.vgrow="ALWAYS"
                  HBox.hgrow="ALWAYS"
                  styleClass="panel">

                <Label text="Clientes registrados"
                       styleClass="titulo-seccion"/>

                <TableView fx:id="tablaClientes"
                           VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn fx:id="columnaNombre"
                                     text="Nombre"
                                     prefWidth="170"/>

                        <TableColumn fx:id="columnaIdentificacion"
                                     text="Identificación"
                                     prefWidth="120"/>

                        <TableColumn fx:id="columnaTelefono"
                                     text="Teléfono"
                                     prefWidth="110"/>

                        <TableColumn fx:id="columnaDireccion"
                                     text="Dirección"
                                     prefWidth="170"/>

                    </columns>

                </TableView>

            </VBox>

        </HBox>
    </center>

    <padding>
        <Insets top="10" right="25" bottom="25" left="25"/>
    </padding>

</BorderPane>