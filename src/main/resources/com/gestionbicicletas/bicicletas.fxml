<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gestionbicicletas.controller.BicicletaController"
            stylesheets="@styles.css">

    <top>

        <HBox spacing="15"
              alignment="CENTER_LEFT">

            <padding>
                <Insets top="20"
                        right="25"
                        bottom="20"
                        left="25"/>
            </padding>

            <Button text="← Volver"
                    onAction="#volverAlMenu"
                    styleClass="boton-secundario"/>

            <Label text="Gestión de Bicicletas"
                   styleClass="titulo-principal"/>

        </HBox>

    </top>

    <center>

        <HBox spacing="30">

            <!-- FORMULARIO -->

            <VBox prefWidth="350"
                  spacing="15"
                  styleClass="panel">

                <Label text="Registrar bicicleta"
                       styleClass="titulo-seccion"/>

                <GridPane hgap="10"
                          vgap="12">

                    <Label text="Cliente:"
                           GridPane.rowIndex="0"
                           GridPane.columnIndex="0"/>

                    <ComboBox fx:id="comboCliente"
                              promptText="Selecciona un cliente"
                              prefWidth="210"
                              GridPane.rowIndex="0"
                              GridPane.columnIndex="1"/>


                    <Label text="Marca:"
                           GridPane.rowIndex="1"
                           GridPane.columnIndex="0"/>

                    <TextField fx:id="txtMarca"
                               promptText="Marca"
                               GridPane.rowIndex="1"
                               GridPane.columnIndex="1"/>


                    <Label text="Tipo:"
                           GridPane.rowIndex="2"
                           GridPane.columnIndex="0"/>

                    <ComboBox fx:id="comboTipo"
                              promptText="Selecciona el tipo"
                              prefWidth="210"
                              GridPane.rowIndex="2"
                              GridPane.columnIndex="1"/>


                    <Label text="Color:"
                           GridPane.rowIndex="3"
                           GridPane.columnIndex="0"/>

                    <TextField fx:id="txtColor"
                               promptText="Color"
                               GridPane.rowIndex="3"
                               GridPane.columnIndex="1"/>


                    <Label text="Serial:"
                           GridPane.rowIndex="4"
                           GridPane.columnIndex="0"/>

                    <TextField fx:id="txtSerial"
                               promptText="Número de serial"
                               GridPane.rowIndex="4"
                               GridPane.columnIndex="1"/>


                    <Label text="Año:"
                           GridPane.rowIndex="5"
                           GridPane.columnIndex="0"/>

                    <TextField fx:id="txtAnio"
                               promptText="Año"
                               GridPane.rowIndex="5"
                               GridPane.columnIndex="1"/>

                </GridPane>

                <VBox spacing="10">

                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Button
                                text="Registrar"
                                styleClass="boton-principal"
                                prefWidth="120"
                                minWidth="120"
                                onAction="#registrarBicicleta"/>

                        <Button
                                text="Limpiar"
                                styleClass="boton-secundario"
                                prefWidth="100"
                                minWidth="100"
                                onAction="#limpiarCampos"/>
                    </HBox>

                    <Button
                            text="Eliminar seleccionado"
                            styleClass="boton-eliminar"
                            prefWidth="230"
                            minWidth="230"
                            onAction="#eliminarBicicleta"/>

                </VBox>

            </VBox>


            <!-- TABLA -->

            <VBox spacing="15"
                  VBox.vgrow="ALWAYS"
                  HBox.hgrow="ALWAYS"
                  styleClass="panel">

                <Label text="Bicicletas registradas"
                       styleClass="titulo-seccion"/>

                <TableView fx:id="tablaBicicletas"
                           VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn fx:id="columnaCliente"
                                     text="Cliente"
                                     prefWidth="150"/>

                        <TableColumn fx:id="columnaMarca"
                                     text="Marca"
                                     prefWidth="100"/>

                        <TableColumn fx:id="columnaTipo"
                                     text="Tipo"
                                     prefWidth="100"/>

                        <TableColumn fx:id="columnaColor"
                                     text="Color"
                                     prefWidth="90"/>

                        <TableColumn fx:id="columnaSerial"
                                     text="Serial"
                                     prefWidth="150"/>

                        <TableColumn fx:id="columnaAnio"
                                     text="Año"
                                     prefWidth="70"/>

                    </columns>

                </TableView>

            </VBox>

        </HBox>

    </center>

    <padding>
        <Insets top="10"
                right="25"
                bottom="25"
                left="25"/>
    </padding>

</BorderPane>